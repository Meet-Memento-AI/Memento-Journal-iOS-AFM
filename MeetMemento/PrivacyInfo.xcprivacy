<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App does not track users across apps/websites -->
    <key>NSPrivacyTracking</key>
    <false/>

    <!-- No tracking domains since tracking is disabled -->
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!-- The app is on-device only: journal content, the display name, and all
         other data stay on the device and are never transmitted off it, so no
         data is "collected" in the App Store privacy sense. -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <!-- APIs accessed by the app that require reasons -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- UserDefaults: App preferences and settings -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
        <!-- File Timestamp: C617.1 — metadata of files inside the app container.
             Justified by LocalJournalStorage.modificationDate(entryId:), which
             reads .modificationDate via FileManager.attributesOfItem. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>
        <!-- NOTE: NSPrivacyAccessedAPICategorySystemBootTime (35F9.1) was
             declared here for "security features" but no boot-time API is
             called anywhere in the app. Removed 2026-08-07 — declare exactly
             what you call. Enforced by scripts/ci/check_privacy_manifest.sh;
             rationale in docs/app-store/03-privacy-labels-and-manifest.md. -->
    </array>
</dict>
</plist>
